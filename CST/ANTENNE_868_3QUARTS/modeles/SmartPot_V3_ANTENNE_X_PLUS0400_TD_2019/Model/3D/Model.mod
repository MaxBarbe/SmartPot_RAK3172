Group.AddItem "solid$Cuivre_f_cu:RF_RESTORE_002", "RF_path_detail"
Group.AddItem "solid$Cuivre_f_cu:RF_RESTORE_003", "RF_path_detail"
With MeshSettings
With .ItemMeshSettings("group$RF_contacts_detail")
.SetMeshType "Hex"
.Set "UseForRefinement", "1"
.Set "UseStepAndExtend", "1"
.Set "UseSameStepWidthXYZ", "0"
.Set "Step", "0.15", "0.15", "0.025"
End With
With .ItemMeshSettings("group$RF_path_detail")
.SetMeshType "Hex"
.Set "UseForRefinement", "1"
.Set "UseStepAndExtend", "1"
.Set "UseSameStepWidthXYZ", "0"
.Set "Step", "0.3", "0.3", "0"
End With
End With

'@ Proposed assembly: replace R4 0 ohm with series 8.2 pF

'[VERSION]2019.0|28.0.2|20180920[/VERSION]
Solid.Delete "RF_Components:R4_zero_ohm_link"
With LumpedElement
.Reset
.SetName "R4_REPLACE_C8p2_SERIES"
.Folder "RF_matching"
.SetType "rlcserial"
.SetR 0
.SetL 0
.SetC 8.2e-12
.SetP1 False, 54.675, -69.8, 0.975
.SetP2 False, 56.325, -69.8, 0.975
.SetRadius 0
.SetMonitor True
.Create
End With

'@ Repair R4 lumped terminals on facing metal surfaces

'[VERSION]2019.0|28.0.2|20180920[/VERSION]
LumpedElement.Delete "RF_matching:R4_REPLACE_C8p2_SERIES"
With LumpedElement
.Reset
.SetName "R4_REPLACE_C8p2_SERIES"
.Folder "RF_matching"
.SetType "rlcserial"
.SetR 0
.SetL 0
.SetC 8.2e-12
.SetP1 False, 54.825, -69.8, 0.9
.SetP2 False, 56.175, -69.8, 0.9
.SetRadius 0
.SetMonitor True
.Create
End With

'@ R4 series 8.2pF edge element for tetrahedral solver

'[VERSION]2019.0|28.0.2|20180920[/VERSION]
If LumpedElement.StartLumpedElementNameIteration() > 0 Then LumpedElement.Delete "RF_matching:R4_REPLACE_C8p2_SERIES"
Pick.ClearAllPicks
With LumpedElement
.Reset
.SetName "R4_REPLACE_C8p2_SERIES"
.Folder "RF_matching"
.SetType "rlcserial"
.SetR 0
.SetL 0
.SetC 8.2e-12
.SetP1 False, 54.825, -69.8, 0.9
.SetP2 False, 56.175, -69.8, 0.9
.SetRadius 0
.SetMonitor True
.Create
End With

'@ R4 differential test port for external reactive loading

'[VERSION]2019.0|28.0.2|20180920[/VERSION]
LumpedElement.Delete "RF_matching:R4_REPLACE_C8p2_SERIES"
Pick.ClearAllPicks
With DiscretePort
.Reset
.PortNumber 2
.Label "R4_loading_test_port"
.Type "SParameter"
.Impedance 50
.SetP1 False, 54.825, -69.8, 0.9
.SetP2 False, 56.175, -69.8, 0.9
.InvertDirection False
.LocalCoordinates False
.Monitor False
.Radius 0
.Create
End With

'@ set pba mesh type

'[VERSION]2019.0|28.0.2|20180920[/VERSION]
Mesh.MeshType "PBA"

'@ Antenna excitation between RF trace and added adjacent grounded trace

'[VERSION]2019.0|28.0.2|20180920[/VERSION]
Port.Delete 2
Port.Delete 1
With Brick
.Reset
.Name "R4_zero_ohm_link"
.Component "RF_Components"
.Material "Cuivre"
.Xrange 54.525, 56.475
.Yrange -69.95, -69.65
.Zrange 0.95, 1
.Create
End With
With Brick
.Reset
.Name "Antenna_adjacent_ground_trace"
.Component "RF_Components"
.Material "Cuivre"
.Xrange 52.45, 52.65
.Yrange -61, -58
.Zrange 0.765, 0.8
.Create
End With
With DiscretePort
.Reset
.PortNumber 1
.Label "ANTENNE_entre_piste_RF_et_retour_masse_50ohm"
.Type "SParameter"
.Impedance 50
.SetP1 False, 52.044673, -59, 0.8
.SetP2 False, 52.55, -59, 0.8
.InvertDirection False
.LocalCoordinates False
.Monitor True
.Radius 0
.Create
End With

'@ Adjacent antenna trace: 1mm width and 35um copper, port across gap

'[VERSION]2019.0|28.0.2|20180920[/VERSION]
Solid.Delete "RF_Components:Antenna_adjacent_ground_trace"
With Brick
.Reset
.Name "Antenna_adjacent_ground_trace"
.Component "RF_Components"
.Material "Cuivre"
.Xrange 52.45, 53.45
.Yrange -61, -58
.Zrange 0.765, 0.8
.Create
End With



'@ Remove middle feed; top-connected 7mm strip with lumped port across lower gap

'[VERSION]2019.0|28.0.2|20180920[/VERSION]
Port.Delete 1
Solid.Delete "RF_Components:Antenna_adjacent_ground_trace"
With Brick
.Reset
.Name "Remove_old_middle_feed"
.Component "TemporaryCuts"
.Material "Cuivre"
.Xrange 51.939673, 52.149673
.Yrange -60.81, -51.49
.Zrange 0.755, 0.81
.Create
End With
Solid.Subtract "Cuivre_f_cu:RF_RESTORE_000", "TemporaryCuts:Remove_old_middle_feed"
With Brick
.Reset
.Name "Antenna_top_feed_3quarters"
.Component "RF_Components"
.Material "Cuivre"
.Xrange 52.45, 53.45
.Yrange -58.4, -51.4
.Zrange 0.765, 0.8
.Create
End With
With DiscretePort
.Reset
.PortNumber 1
.Label "ANTENNE_piste_haut_3quarts_gap_bas_50ohm"
.Type "SParameter"
.Impedance 50
.SetP1 False, 52.95, -58.3, 0.8
.SetP2 False, 52.95, -60.75, 0.8
.InvertDirection False
.LocalCoordinates False
.Monitor True
.Radius 0
.Create
End With



'@ Tune antenna feed position X, offset 0.4 mm

'[VERSION]2019.0|28.0.2|20180920[/VERSION]
Port.Delete 1
Solid.Delete "RF_Components:Antenna_top_feed_3quarters"
With Brick
.Reset
.Name "Antenna_top_feed_3quarters"
.Component "RF_Components"
.Material "Cuivre"
.Xrange 52.85, 53.85
.Yrange -58.4, -51.4
.Zrange 0.765, 0.8
.Create
End With
With DiscretePort
.Reset
.PortNumber 1
.Label "ANTENNE_piste_haut_3quarts_gap_bas_50ohm"
.Type "SParameter"
.Impedance 50
.SetP1 False, 53.35, -58.3, 0.8
.SetP2 False, 53.35, -60.75, 0.8
.InvertDirection False
.LocalCoordinates False
.Monitor True
.Radius 0
.Create
End With
With MeshSettings
.SetMeshType "Hex"
.Set "UseRatioLimitGeometry", "0"
.Set "UseSameMinStepGeometryXYZ", "0"
.Set "MinStepGeometryX", "0.5"
.Set "MinStepGeometryY", "0.5"
.Set "MinStepGeometryZ", "0.08"
With .ItemMeshSettings("group$RF_contacts_detail")
.SetMeshType "Hex"
.Set "Step", "0.5", "0.5", "0"
End With
With .ItemMeshSettings("group$RF_path_detail")
.SetMeshType "Hex"
.Set "Step", "0.5", "0.5", "0"
End With
End With
Mesh.MergeThinPECLayerFixpoints True



